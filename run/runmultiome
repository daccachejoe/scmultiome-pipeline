#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

usage() {
    cat <<EOF
Usage: run/runmultiome <stage>

Trunk stages (run in this strict order):
  init                  00 - set up project directories and install R deps
  seurat_preprocess     01 - per-sample Seurat/Signac QC + peak calling
  run_merged_pipeline   02 - filter + merge samples into one object
  identify_celltypes    03 - UCDeconvolve-assisted cell type calling
  label_celltypes       04 - apply user-provided cluster labels
  call_peaks_grouped    05 - re-call ATAC peaks grouped by cell type
  linkpeaks             06 - link ATAC peaks to nearby genes (parallel, one job per group)

Downstream branches (optional, independent of each other, run any/all
after stage 05 -- peak-gene linking above is standard; these are
exploratory/heavyweight extras):
  filter_and_cluster     subcluster within cell lineages
  run_scenicplus         (extra environments required) SCENIC+ regulon inference

Run per-sample stages, then review outputs in output/, before moving to
the next stage. See README.md for the full walkthrough.

Examples:
  # normal run, using this stage's default time/mem/cores and input
  run/runmultiome seurat_preprocess

  # same stage, with more cores/memory and a different input object for
  # just this one run (TIME/MEM/CORES/INPUT_RDS all revert to defaults
  # next time you don't set them)
  CORES=64 MEM=64000 INPUT_RDS=output/RDS-files/my-variant-obj-list.RDS run/runmultiome call_peaks_grouped

Each stage submits its job with its own default time/mem/cores. Override
any of them for a single run with TIME/MEM/CORES env vars.
Most trunk/downstream stages also accept an INPUT_RDS override to point
at a different input object -- see the comment near the top of each
routes/*.sh file for its exact default.
EOF
}

detect_scheduler() {
    # change this to be some SLURM variable present in the login node
    if [ ! -z "$SLURM_JOB_ID" ]; then
        echo "SLURM detected"
        export SCHEDULER="slurm"
    elif [ ! -z "$LSF_ENVDIR" ]; then
        echo "LSF detected"
        export SCHEDULER="lsf"
    else
        echo "No known job scheduler detected"
        export SCHEDULER="none"
    fi
}

submit_job() {
    local script=$1
    local output=$2
    # each stage passes its own sensible default time/mem/cores; set
    # TIME/MEM/CORES before invoking run/runmultiome to override them for
    # that one run, e.g.: CORES=64 MEM=64000 run/runmultiome seurat_preprocess
    local time=${TIME:-$3}
    local mem=${MEM:-$4}
    local cores=${CORES:-$5}

    if [ "$SCHEDULER" == "slurm" ]; then
        time=0-$time:00
        sbatch -c $cores -p "$slurm_partition" --mem-per-cpu $mem -o $output -t $time --export=ALL $script
    elif [ "$SCHEDULER" == "lsf" ]; then
        bsub -P "$lsf_project" -q "$lsf_queue" -n $cores -R "rusage[mem=$mem]" -R span[hosts=1] -o $output -W $time $script
    else
        echo "No job scheduler available to submit job: $script"
    fi
}

init() {
    echo "Initializing environment"
    if [ ! -f config/pipeline.config ]; then
        cp config/pipeline.config.example config/pipeline.config
        echo "Created config/pipeline.config from the template."
        echo "Edit it with your HPC/environment values before running further stages."
    fi
    bash routes/00_setup_dirs.sh
    bash routes/00_install.sh
}

seurat_preprocess() {
    echo "Step 01: Running seurat preprocessing"
    submit_job routes/01_seurat_preprocess.sh scripts/outs/01-preprocessing-%J.out 12:00 24000 32
}

run_merged_pipeline() {
    echo "Step 02: Running merged pipeline"
    submit_job routes/02_merge_pipeline.sh scripts/outs/02-merged-pipeline-%J.out 12:00 48000 32
}

identify_celltypes() {
    echo "Step 03: Helping identify cell types"
    submit_job routes/03_identify_celltypes.sh scripts/outs/03-identify-celltypes-%J.out 12:00 24000 32
}

label_celltypes() {
    echo "Step 04: Labelling cell types with user inputs"
    submit_job routes/04_label_celltypes.sh scripts/outs/04-label-celltypes-%J.out 12:00 24000 32
}

call_peaks_grouped() {
    echo "Step 05: Calling ATAC-Seq peaks grouped by cell type"
    submit_job routes/05_call_peaks_grouped.sh scripts/outs/05-callpeaks-grouped-%J.out 36:00 32000 24
}

linkpeaks() {
    echo "Step 06: Linking peaks to genes"
    submit_job routes/06_linkpeaks.sh scripts/outs/06-linkpeaks-%J.out 36:00 12000 6
}

# Downstream branches (optional) -- read stage 05's output independently;
# run any or all of them in any order once call_peaks_grouped has completed.

filter_and_cluster() {
    echo "Downstream branch: subclustering within cell lineages"
    submit_job routes/downstream/subcluster.sh scripts/outs/subcluster-%J.out 36:00 32000 24
}

run_scenicplus() {
    echo "Downstream branch (extra environments required): running SCENIC+"
    submit_job routes/downstream/run_scenicplus.sh scripts/outs/scenicplus-%J.out 12:00 40000 32
}

run_multiome() {
    if [ $# -eq 0 ] || [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
        usage
        exit 0
    fi

    if ! declare -f "$1" > /dev/null; then
        echo "Unknown stage: $1"
        usage
        exit 1
    fi

    # Run the specified function based on the argument
    "$1"
}

if [ $# -eq 0 ] || [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
    usage
    exit 0
fi

CONFIG_FILE="config/pipeline.config"
if [ ! -f "$CONFIG_FILE" ] && [ "$1" != "init" ]; then
    echo "config/pipeline.config not found."
    echo "Run 'run/runmultiome init' first to create it from the template, then fill in your values."
    exit 1
fi
if [ -f "$CONFIG_FILE" ]; then
    set -a
    source "$CONFIG_FILE"
    set +a
fi

# Detect the scheduler before running any jobs
detect_scheduler

# Call the run_multiome function with the provided argument
run_multiome "$1"


