#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

usage() {
    cat <<EOF
Usage: run/runmultiome <stage>

Stages (run in this order):
  init                  00 - set up project directories and install R deps
  seurat_preprocess     01 - per-sample Seurat/Signac QC + peak calling
  run_merged_pipeline   02a - filter + merge samples into one object
  filter_and_cluster    02b - subcluster within cell lineages
  identify_celltypes    03 - UCDeconvolve-assisted cell type calling
  label_celltypes       04 - apply user-provided cluster labels
  call_peaks_grouped    05 - re-call ATAC peaks grouped by cell type
  linkpeaks             06 - link ATAC peaks to nearby genes
  run_scenicplus        07 - (optional) SCENIC+ regulon inference

Run per-sample stages, then review outputs in output/, before moving to
the next stage. See README.md for the full walkthrough.
EOF
}

detect_scheduler() {
    # change this to be some SLURM variable present in the login node
    if [ ! -z "$SLURM_JOB_ID" ]; then
        echo "SLURM detected"
        export SCHEDULER="slurm"
    elif [ ! -z "$LSF_ENVDIR" ]; then
        echo "LSF detected"
        export SCHEDULER="lsf"
    else
        echo "No known job scheduler detected"
        export SCHEDULER="none"
    fi
}

submit_job() {
    local script=$1
    local output=$2
    local time=$3
    local mem=$4
    local cores=$5

    if [ "$SCHEDULER" == "slurm" ]; then
        time=0-$time:00
        sbatch -c $cores -p "$slurm_partition" --mem-per-cpu $mem -o $output -t $time --export=ALL $script
    elif [ "$SCHEDULER" == "lsf" ]; then
        bsub -P "$lsf_project" -q "$lsf_queue" -n $cores -R "rusage[mem=$mem]" -R span[hosts=1] -o $output -W $time $script
    else
        echo "No job scheduler available to submit job: $script"
    fi
}

init() {
    echo "Initializing environment"
    if [ ! -f config/pipeline.config ]; then
        cp config/pipeline.config.example config/pipeline.config
        echo "Created config/pipeline.config from the template."
        echo "Edit it with your HPC/environment values before running further stages."
    fi
    bash routes/setup_dirs.sh
    bash routes/install.sh
}

seurat_preprocess() {
    echo "Running seurat preprocessing"
    submit_job routes/seurat_preprocess.sh scripts/outs/preprocessing-%J.out 12:00 24000 32
}

filter_and_cluster() {
    echo "Running filtering and clustering"
    submit_job routes/filter_and_cluster.sh scripts/outs/filter-and-cluster-%J.out 36:00 32000 24
}

run_merged_pipeline() {
    echo "Running merged pipeline"
    submit_job routes/merged_pipeline.sh scripts/outs/merged-pipeline-%J.out 12:00 48000 32
}

identify_celltypes() {
    echo "Helping identify cell types"
    submit_job routes/identify_celltypes.sh scripts/outs/identify-celltypes-%J.out 12:00 24000 32
}

label_celltypes() {
    echo "Labelling cell types with user inputs"
    submit_job routes/label_celltypes.sh scripts/outs/label-celltypes-%J.out 12:00 24000 32
}

call_peaks_grouped() {
    echo "Calling ATAC-Seq peaks grouped by cell type"
    submit_job routes/call_peaks_grouped.sh scripts/outs/callpeaks-grouped-%J.out 36:00 32000 24
}

linkpeaks() {
    echo "Linking peaks to genes"
    submit_job routes/linkpeaks.sh scripts/outs/linkpeaks-%J.out 36:00 12000 6
}

run_scenicplus() {
    echo "Running SCENIC+"
    submit_job routes/run_scenicplus.sh scripts/outs/scenicplus-%J.out 12:00 40000 32
    # submit_job routes/run_scenicplus.sh scripts/outs/scenicplus-%J.out 120:00 18000 24
}

run_multiome() {
    if [ $# -eq 0 ] || [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
        usage
        exit 0
    fi

    if ! declare -f "$1" > /dev/null; then
        echo "Unknown stage: $1"
        usage
        exit 1
    fi

    # Run the specified function based on the argument
    "$1"
}

if [ $# -eq 0 ] || [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
    usage
    exit 0
fi

CONFIG_FILE="config/pipeline.config"
if [ ! -f "$CONFIG_FILE" ] && [ "$1" != "init" ]; then
    echo "config/pipeline.config not found."
    echo "Run 'run/runmultiome init' first to create it from the template, then fill in your values."
    exit 1
fi
if [ -f "$CONFIG_FILE" ]; then
    set -a
    source "$CONFIG_FILE"
    set +a
fi

# Detect the scheduler before running any jobs
detect_scheduler

# Call the run_multiome function with the provided argument
run_multiome "$1"


